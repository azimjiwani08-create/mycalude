# ---------------------------------------------------------------
# Edu Tower education build. Copy to .env.local for local dev.
# Set separately for Preview and Production in Vercel.
# Never prefix any of these with NEXT_PUBLIC_ — none may reach the browser.
# ---------------------------------------------------------------

# Master switch. "true" (or unset) = whole site serves sample data.
# Flip to "false" only once the database and keys below are set.
EDU_DEMO_MODE=true

# Signs session cookies. 32+ random bytes.
SESSION_SECRET=

# Postgres (Supabase). Service role key is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=edu-private

# OpenAI (server-only). Also set a hard monthly cap in the OpenAI dashboard.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
AI_DAILY_LIMIT_PER_USER=40

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# WhatsApp Business (Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Counsellor numbers for wa.me handoff links, digits only
WHATSAPP_COUNSELLOR_MUMBAI=919800000001
WHATSAPP_COUNSELLOR_VADODARA=919800000002
